<roster id="gtsbs-02" name="GTSBS 02 – Nur Regiment A traegt eine Blessed-Spawning-Option: A wird Special, B bleibt Core" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored greater-than-self-blessed-spawning-slots E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
