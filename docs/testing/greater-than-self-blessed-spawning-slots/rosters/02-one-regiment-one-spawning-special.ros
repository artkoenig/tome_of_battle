      <selections>
        <!-- Regiment A: GENAU EINE Blessed-Spawning-Option (Tzunki, 10 pts).
             Selbst-Zaehlung von bd30-a138-fa7a-ecbe = 1.
             greaterThan 0 haelt (1 > 0)  => add/set-primary Special 43cc-..., remove Core 64bf-...
             greaterThan 1 haelt NICHT (1 ist nicht strikt groesser als 1) => KEIN Rare.
             Effektive Kategorien von A: {Special}.
             Der <categories>-Block notiert bewusst weiter den ROHEN Core-Link. -->
        <selection id="sel-swa" name="Saurus Warriors" entryId="2258-e16e-24dd-6e85" entryLinkId="" number="1" type="unit" collective="false">
          <categories>
