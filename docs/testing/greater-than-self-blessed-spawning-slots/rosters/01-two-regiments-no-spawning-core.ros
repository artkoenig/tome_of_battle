<roster id="gtsbs-01" name="GTSBS 01 – Zwei Saurus-Regimenter ohne Blessed Spawning: beide bleiben Core" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored greater-than-self-blessed-spawning-slots E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <costLimits>
    <!-- 1000 pts: keine Punkte-Bracket der .gst-Kategoriegrenzen haelt (alle
         Anhebungen verlangen >=2000, die Warband-Varianten <500, die
         Border-Patrols-Varianten eine Border-Patrols-Selektion 4e15-...).
         Effektiv: Core min 2 (35c2-...), Special max 3 (16f0-...), Rare max 1 (0a44-...). -->
    <costLimit name="pts" typeId="ecfa-8486-4f6c-c249" value="1000.0"/>
  </costLimits>
  <forces>
    <!-- Kontingent "Standard (LM-AB)" 8fcd-0130-a0ff-b7bc. Bewusst NICHT
         "Southlands (LM-AB)" fe15-38b7-daea-2ec8: dessen instanceOf-Gatter wuerde
         Saurus Warriors unbedingt nach Special schieben und die Selbst-Zaehlung
         ueberdecken. Kroq-Gar (859a-...) und "Sacred Host of the Gods"
         (b5ff-...) fehlen ebenfalls, damit die aeussere Klammer (equalTo 0)
         haelt und der Sacred-Host-Zaehler 0 ist. -->
    <force id="force-1" name="Standard (LM-AB)" entryId="8fcd-0130-a0ff-b7bc" catalogueId="19e3-92e5-1158-4551" catalogueRevision="1" catalogueName="Lizardmen (6th definitive edition)">
      <selections>
        <!-- Regiment A: KEINE Blessed-Spawning-Option.
             Selbst-Zaehlung von bd30-a138-fa7a-ecbe = 0.
             greaterThan 0 haelt NICHT (0 ist nicht strikt groesser als 0)
             => kein Wechsel nach Special. greaterThan 1 haelt erst recht nicht.
             Rohe Kategorie Core (categoryLink 4e44-1ec9-460f-8c88) bleibt. -->
        <selection id="sel-swa" name="Saurus Warriors" entryId="2258-e16e-24dd-6e85" entryLinkId="" number="1" type="unit" collective="false">
