            <selection id="sel-lordcost" name="Lord hero choice extra cost" entryId="42c5-9ebc-7493-89ef" entryLinkId="" number="1" type="upgrade" collective="false"/>
            <selection id="sel-bloodline" name="Blood Dragon" entryId="0158-ed16-cbbf-6a78" entryLinkId="" number="1" type="upgrade" collective="false">
              <categories>
                <category id="4cae-a20e-8374-b6cb" name="Blood Dragon" entryId="4cae-a20e-8374-b6cb" primary="false"/>
              </categories>
