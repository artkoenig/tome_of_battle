        <!-- Zweiter Vampir: Vampire Count (6822-0110-a7c9-cbb0) mit seinen
             eigenen Pflicht-Kindern - Handweapon 7b76-de50-6c9b-60c3 (min 1,
             4c68-90d8-4b3a-544f), Bloodline-Gruppe 63e7-ac1b-014b-3b28 (min 1,
             56c1-3e68-6f24-3768) und Wizard-Level-Gruppe 7ab1-d9dc-6124-443f
             (min 1, 19ba-de18-6ad7-2825). -->
        <selection id="sel-vc" name="Vampire Count" entryId="6822-0110-a7c9-cbb0" entryLinkId="" number="1" type="unit" collective="false">
          <categories>
            <category id="d024-d25b-a9b4-73b6" name="Lord" entryId="d024-d25b-a9b4-73b6" primary="true"/>
          </categories>
