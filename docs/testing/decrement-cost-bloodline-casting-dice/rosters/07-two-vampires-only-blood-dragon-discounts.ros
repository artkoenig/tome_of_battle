<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="dcb-07" name="DCB 07 - zwei Vampire: nur der Blood-Dragon-Vampir bekommt den Abzug" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored decrement-cost-bloodline-casting-dice E2E fixture)" gameSystemId="6d8e-38d9-3c69-febf" gameSystemName="Warhammer Fantasy Battle 6th edition" gameSystemRevision="8" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <!-- Der Trennfall: die Blood-Dragon-Kategorie steht im Kontingent, aber nur
       unter EINEM der beiden Vampire. Der Rahmen der Bedingung ist
       scope="parent" - die Elternauswahl des Traegers -, nicht das Kontingent.
       Rechnung: Lord (Blood Dragon) Wizard level 2 = 2-1 = 1
                 Count (Strigoi)     Wizard level 1 = 1   (kein Abzug)
                 Summe 2 > Budget 1  => die Budget-Regel feuert.
       Eine kontingent- oder rosterweite Fehl-Lesart des Rahmens verbilligte
       auch den Count (1-1 = 0), ergaebe Summe 1 und liesse die Regel
       schweigen. pts: 285 + 205 = 490. -->
  <costLimits>
    <costLimit typeId="ecfa-8486-4f6c-c249" name="pts" value="2000"/>
    <costLimit typeId="fcec-2340-6368-a2ba" name=" Casting Dice" value="1"/>
  </costLimits>
  <forces>
    <force id="force-1" name="Standard " entryId="7d9d-6c8d-4ea0-b7ad" catalogueId="ea4b-9294-3427-1fc1" catalogueRevision="10" catalogueName="Vampire Counts">
      <selections>
        <selection id="sel-vl" name="Vampire Lord" entryId="b77b-88d5-5e80-e178" entryLinkId="" number="1" type="unit" collective="false">
          <categories>
            <category id="d024-d25b-a9b4-73b6" name="Lord" entryId="d024-d25b-a9b4-73b6" primary="true"/>
          </categories>
          <selections>
