          </categories>
          <selections>
            <selection id="sel-team-a" name="Reaper Bolt Thrower team" entryId="8d99-db74-0051-4a45" entryLinkId="" number="1" type="model" collective="false">
              <costs>
                <cost name="pts" typeId="ecfa-8486-4f6c-c249" value="100"/>
              </costs>
              <selections>
                <selection id="sel-team-a-crew-a" name="Crew" entryId="60b3-aed5-bac2-0bd4" entryLinkId="" number="1" type="upgrade" collective="false">
                  <selections>
                    <selection id="sel-team-a-crew-a-hw" name="Hand Weapon" entryId="ef5d-1234-9f7f-7f69" entryLinkId="" entryGroupId="f3eb-28b5-64be-28bd" number="1" type="upgrade" collective="false"/>
                    <selection id="sel-team-a-crew-a-la" name="Light Armour" entryId="055f-8e4e-f170-35d2" entryLinkId="381e-0653-e9c9-dc6a" entryGroupId="f3eb-28b5-64be-28bd" number="1" type="upgrade" collective="false"/>
                  </selections>
                </selection>
                <selection id="sel-team-a-crew-b" name="Crew" entryId="60b3-aed5-bac2-0bd4" entryLinkId="" number="1" type="upgrade" collective="false">
                  <selections>
                    <selection id="sel-team-a-crew-b-hw" name="Hand Weapon" entryId="ef5d-1234-9f7f-7f69" entryLinkId="" entryGroupId="f3eb-28b5-64be-28bd" number="1" type="upgrade" collective="false"/>
                    <selection id="sel-team-a-crew-b-la" name="Light Armour" entryId="055f-8e4e-f170-35d2" entryLinkId="381e-0653-e9c9-dc6a" entryGroupId="f3eb-28b5-64be-28bd" number="1" type="upgrade" collective="false"/>
