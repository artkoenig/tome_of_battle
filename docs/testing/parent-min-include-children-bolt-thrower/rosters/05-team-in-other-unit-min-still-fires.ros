        </selection>
        <!-- EINHEIT B: dieselbe Definition, aber OHNE Team. scope="parent"
             macht jede Einheiten-Instanz zu ihrem eigenen Rahmen: das Team
             der Einheit A zaehlt hier nicht mit, die Zaehlung steht auf 0 und
             41ec feuert — genau einmal, naemlich fuer diesen Rahmen. Eine
             roster-weite Lesart von shared="true" saehe dagegen ein Team im
             Roster und bliebe still. -->
        <selection id="sel-rbt-unit-b" name="Reaper Bolt Thrower" entryId="a757-462a-11d5-9636" entryLinkId="" number="1" type="unit" collective="false">
