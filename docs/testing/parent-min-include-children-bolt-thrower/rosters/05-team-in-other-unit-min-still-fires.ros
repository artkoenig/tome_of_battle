<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="pmicb-05" name="PMICB 05 - Zwei Reaper Bolt Thrower: das Team der einen Einheit erfuellt die Pflicht der anderen NICHT (41ec feuert genau einmal, Ist 0 / Grenze 1)" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored parent-min E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <costLimits>
    <costLimit typeId="ecfa-8486-4f6c-c249" name="pts" value="2000"/>
  </costLimits>
  <forces>
    <!-- Kontingent "Standard (DE-AB)": Einheit sichtbar, Kategorie "Rare"
         (siehe Kommentar in Roster 01). Bei 2000 pts erlaubt die Rare-Grenze
         0a44-2d3f-adfe-f3a1 der .gst zwei Rare-Auswahlen (set 2 fuer
         2000-2999 pts) — die beiden Einheiten sind also katalog-legal
         nebeneinander waehlbar. -->
    <force id="force-1" name="Standard (DE-AB)" entryId="26bc-729f-a188-f285" catalogueId="d4c0-4f0c-4a89-40fc" catalogueRevision="1" catalogueName="Dark Elves">
      <selections>
        <!-- EINHEIT A: vollstaendig, mit einem Team. In IHREM Rahmen steht die
             Zaehlung des Traegers auf 1 — 41ec ist hier erfuellt. -->
        <selection id="sel-rbt-unit-a" name="Reaper Bolt Thrower" entryId="a757-462a-11d5-9636" entryLinkId="" number="1" type="unit" collective="false">
          <categories>
