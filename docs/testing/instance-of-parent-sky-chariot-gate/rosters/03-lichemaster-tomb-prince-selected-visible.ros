  <forces>
    <!-- Wie 01, aber der Sky Chariot ist tatsaechlich gewaehlt: der Slot ist
         belegt statt bloss angeboten. Die Auswahl traegt die Ziel-Id des
         geteilten Eintrags (entryId 33bd-1a1e-a286-60ac) und die Id des
         Verweises, ueber den sie erreicht wird (entryLinkId
         472e-d107-b0dc-c51a). Zwischen Tomb Prince und Verweis liegen nur
         selectionEntryGroups (7611-df97-0864-39a3 -> 81c5-7ea4-7cb5-61d4);
         Gruppen erzeugen keine Selektion, der Eltern-Rahmen der Bedingung ist
         also die Tomb-Prince-Auswahl selbst.
         Punkte: 100 (Tomb Prince) + 50 (Sky Chariot) = 150 von 3000. -->
    <force id="force-1" name="Army of the Lichemaster (WD#309-UK)" entryId="f37a-a93e-fa22-61a8" catalogueId="4d73-5ab0-9020-403c" catalogueRevision="1" catalogueName="Vampire Counts">
