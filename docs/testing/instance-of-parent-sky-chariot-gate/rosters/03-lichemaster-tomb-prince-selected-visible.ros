<roster id="iopsc-03" name="IOPSC 03 – Army of the Lichemaster, Tomb Prince MIT gewaehltem Sky Chariot (50 pts): belegter Slot, sichtbar" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored instance-of-parent-sky-chariot-gate E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
