<roster id="iopsc-02" name="IOPSC 02 – Army of the Lichemaster, Traeger ist der Necromancer: derselbe Sky-Chariot-Slot bleibt verborgen" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored instance-of-parent-sky-chariot-gate E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
