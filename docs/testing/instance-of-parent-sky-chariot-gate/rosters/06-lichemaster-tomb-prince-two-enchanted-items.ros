<roster id="iopsc-06" name="IOPSC 06 – Gegenprobe (Lebendigkeit): Sky Chariot + Charm of Defiance reissen die max-1-Grenze der Gruppe" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored instance-of-parent-sky-chariot-gate E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
