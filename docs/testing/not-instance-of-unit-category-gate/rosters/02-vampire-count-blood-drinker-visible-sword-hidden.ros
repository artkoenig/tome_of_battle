<roster id="niuc-02" name="NIUC 02 – Vampire Count: Blood Drinker sichtbar, Sword of the Kings verborgen" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored not-instance-of-unit-category-gate E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <forces>
