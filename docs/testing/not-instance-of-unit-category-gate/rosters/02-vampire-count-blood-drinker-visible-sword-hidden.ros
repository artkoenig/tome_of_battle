      <selections>
        <!-- Wie Roster 01: Bloodlines ohne Clan-Auswahl. Ohne Clan greift keine der
             BLOODLINE-modifierGroups des Vampire Count, der Vampir traegt also KEINE
             Clan-Kategorie — die instanceOf-Gatter der Nachbar-Slots bleiben in beiden
             Richtungen ungehalten. Ausserdem ist damit sicher KEIN Strigoi im
             Kontingent, der sonst den Verweis "Magic Items" (14d2-cec2-9b1c-418c)
             und damit den ganzen Magic-Item-Baum des Vampirs verbergen wuerde. -->
        <selection id="sel-bloodlines" name="Bloodlines" entryId="a56a-eb32-5a45-16fd" entryLinkId="" number="1" type="upgrade" collective="false">
          <categories>
            <category id="32f1-197f-d719-a393" name="Special list rules" entryId="32f1-197f-d719-a393" primary="true"/>
          </categories>
        </selection>
        <!-- Vampire Count (6822-0110-a7c9-cbb0, type="unit") — derselbe geteilte
             Magic-Weapons-Baum wie beim Wight Lord, nur ueber eine andere Verweiskette
             erreicht. Seine categoryLinks sind Lord (primaer), Characters und VAMPIRE
             (017d-3857-a815-782f); die Kategorie WIGHT (5c44-3a90-6b26-bc32) fuehrt er
             nicht. Gewaehlt sind nur die beiden Pflicht-Kinder: Handweapon
             (9e6c-19ea-19ad-7cbe, min 1) und genau ein Wizard Level (Gruppe
             7ab1-d9dc-6124-443f, min 1 / max 1). Im Magic-Item-Baum ist NICHTS gewaehlt. -->
        <selection id="sel-vc" name="Vampire Count" entryId="6822-0110-a7c9-cbb0" entryLinkId="" number="1" type="unit" collective="false">
          <categories>
            <category id="d024-d25b-a9b4-73b6" name="Lord" entryId="d024-d25b-a9b4-73b6" primary="true"/>
            <category id="7a1c-d611-c2dc-def1" name="Characters" entryId="7a1c-d611-c2dc-def1" primary="false"/>
            <category id="017d-3857-a815-782f" name="Vampire" entryId="017d-3857-a815-782f" primary="false"/>
          </categories>
          <selections>
            <selection id="sel-vc-handweapon" name="Handweapon" entryId="9e6c-19ea-19ad-7cbe" entryLinkId="" entryGroupId="06c9-c170-adb2-86f5" number="1" type="upgrade" collective="false"/>
