<roster id="prum-03" name="PRUM 03 - Ogre Maneaters mit Great Weapon (ein Wiederholungsschritt), Punktelimit 85 (Budget feuert)" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored parent-repeat-upgrade-maneater-weapons E2E fixture)" gameSystemId="6d8e-38d9-3c69-febf" gameSystemName="Warhammer Fantasy Battle 6th edition" gameSystemRevision="8" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <!-- Wie Roster 01/02, aber statt des Ogre club steht das Great Weapon
       (Link d13c-78a4-0289-7d87 -> .gst 1eb7-3f36-8cf7-e0ba, type="upgrade", 0 pts)
       in der Gruppe "Weapon". Der repeat des Links zaehlt im Eltern-Rahmen (dem
       Modell 8fed-6b86-9099-db53) die Auswahlen vom Typ "upgrade":
       das ist genau die Great-Weapon-Auswahl selbst => Treffer 1
       => floor(1/1) x 1 = 1 Anwendung von increment 6 => Waffe 0 + 6 = 6 pts.
       Summe: 0 + 80 + 0 (Light Armour) + 6 = 86 pts.
       Limit 85 => budget::ecfa-8486-4f6c-c249 feuert mit Ist 86 / Grenze 85.
       Der Aufbau ist bis auf die Waffenidentitaet gleich zu Roster 01/02:
       die Differenz 86 - 80 = 6 ist genau eine Anwendung des Modifikators. -->
  <costLimits>
    <costLimit typeId="ecfa-8486-4f6c-c249" name="pts" value="85"/>
  </costLimits>
  <forces>
    <force id="force-1" name="Standard " entryId="7d9d-6c8d-4ea0-b7ad" catalogueId="4887-12ed-22a2-f461" catalogueRevision="4" catalogueName="Dogs of War">
