  <forces>
    <!-- Gegenprobe (Lebendigkeit) im SELBEN Rahmen: der Core-categoryLink des
         Vampire-Coast-Kontingents (4292-f5de-24ff-93a7) traegt einen echten
         <modifier type="increment" value="1" field="35c2-d478-392a-aeb1"> mit
         <repeat value="1" repeats="1" field="selections" scope="force"
                 childId="8b63-3344-e972-cd0d" (Bloated Corpse) includeChildSelections="true"/>.
         Ein Bloated Corpse (30 pts, Kategorie „Core" 2abb-389b-b6ab-6179, im
         Vampire-Coast-Kontingent aufgedeckt) hebt die Core-Untergrenze also von 4
         (.gst-Klasse 3000-3999) auf 5 — waehrend der haltlose set 1 am Lord-Link
         desselben Kontingents nachweislich nichts bewegt. -->
    <force id="force-1" name="Vampire Coast (WD#306-UK)" entryId="bf46-ee85-7c10-ba98" catalogueId="4d73-5ab0-9020-403c" catalogueRevision="1" catalogueName="Vampire Counts">
