<roster id="nertr-05" name="NERTR 05 - Hell Pit (WD-311) mit derselben Auswahl: die zweite Haelfte der and-Gruppe faellt, Rat Riders bleibt verborgen" battleScribeVersion="2.03" generatedBy="tome-of-battle tester (hand-authored not-equal-to-roster-experimental-rat-riders E2E fixture)" gameSystemId="0d13-7737-ea86-4662" gameSystemName="Warhammer Fantasy Battles (6th definitive edition)" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
