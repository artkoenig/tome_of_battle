  <forces>
    <!-- Selbe Auswahl wie Roster 02, aber im Kontingent "Hell Pit (WD-311)"
         (9f0b-5346-a3bc-b5fe) - genau dem, das die notInstanceOf-Bedingung
         derselben and-Gruppe benennt. Der notEqualTo-Zaehler steht auf NICHT
         NULL (die Bedingung haelt), die and-Gruppe faellt trotzdem, weil ihr
         zweites Mitglied faellt: der set hidden=false bleibt aus, der
         Basiswert hidden="true" bleibt stehen. Gegenprobe dazu, dass die
         Aufdeckung in Roster 02 BEIDE Mitglieder braucht. -->
    <force id="force-1" name="Hell Pit (WD-311)" entryId="9f0b-5346-a3bc-b5fe" catalogueId="cac6-5f02-f95d-a403" catalogueRevision="1" catalogueName="Skaven">
