{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/**/*.js", "src/**/*.jsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ruleengine/engine/*"],
                "message": "Der Evaluator (ADR-0030) wird von aussen ausschliesslich ueber die Fassade src/contexts/ruleengine/evaluator.js angesprochen. Fehlt ein Name dort, ergaenze den Re-Export statt ein internes Modul direkt zu importieren."
              }
            ]
          }
        ]
      }
    },
    {
      // ADR-0038: eine Komponente ist JSX. Zustandsfolgen und Ableitungen
      // gehoeren in ihr ViewModel unter src/ui/viewmodels/ -- ein `useEffect` oder
      // `useMemo` in einer Komponente ist genau die Ableitung im Render, die
      // die Schicht abschaffen soll.
      "files": ["src/ui/components/**/*.js", "src/ui/components/**/*.jsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useMemo", "useLayoutEffect"],
                "message": "ADR-0038: Effekte und Memoisierung gehoeren in das ViewModel des Bildschirms (src/ui/viewmodels/), nicht in die Komponente."
              }
            ],
            "patterns": [
              {
                "group": ["**/ruleengine/engine/*"],
                "message": "Der Evaluator (ADR-0030) wird von aussen ausschliesslich ueber die Fassade src/contexts/ruleengine/evaluator.js angesprochen. Fehlt ein Name dort, ergaenze den Re-Export statt ein internes Modul direkt zu importieren."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/contexts/armylist/model/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ruleengine/**"],
                "message": "Das Schreibmodell src/contexts/armylist/model/ bleibt rein strukturell (Issue 0121, Task 8): es importiert den Evaluator nie -- auch nicht ueber dessen Fassade. Bewertung liest allein die Oberflaeche aus dem Bericht."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/contexts/ruleengine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ruleengine/engine/*"],
                "message": "Der Evaluator (ADR-0030) wird von aussen ausschliesslich ueber die Fassade src/contexts/ruleengine/evaluator.js angesprochen. Fehlt ein Name dort, ergaenze den Re-Export statt ein internes Modul direkt zu importieren."
              },
              {
                "group": ["**/armylist/**"],
                "message": "Die Auswertungs-Bruecke src/contexts/ruleengine/ braucht das Schreibmodell src/contexts/armylist/model/ nicht (Issue 0121, Task 8): sie uebersetzt nur App-Roster -> Evaluator-Vertrag und reicht den Bericht durch."
              }
            ]
          }
        ]
      }
    },
    {
      // Muss nach dem Block fuer src/contexts/ruleengine/** stehen: der spaetere
      // Override gewinnt, sonst verbietet die Fassaden-Regel den Engine-Modulen
      // ihre eigenen Nachbarn.
      "files": ["src/contexts/ruleengine/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/armylist/**"],
                "message": "Reinraum-Schutz (ADR-0030/0034): src/contexts/ruleengine/engine/ darf das App-Schreibmodell src/contexts/armylist/model/ nie importieren -- es traegt Ableitungslogik der Alt-Engine."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.test.js", "src/**/*.test.jsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // Ein Context-Modul veroeffentlicht bewusst seinen Provider (Komponente) zusammen
      // mit dem zugehoerigen Consumer-Hook. Die Regel dient allein dem Fast Refresh des
      // Dev-Servers; sie zu erfuellen hiesse, Context-Objekt, Provider und Hook auf drei
      // Dateien zu verteilen und damit eine Zustaendigkeit zu zersplittern. Die
      // Context-Module liegen seit dem Umzug von src/ui/contexts/ bei den uebrigen
      // ViewModels; der Glob greift sie ueber den Dateinamen heraus.
      "files": ["src/ui/viewmodels/**/*Context.jsx", "src/ui/viewmodels/**/*Contexts.jsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
