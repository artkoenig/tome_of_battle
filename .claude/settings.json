{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "8000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(forge-test:*)",
      "Bash(forge-lint:*)",
      "Bash(forge-typecheck:*)",
      "Bash(forge-build:*)",
      "Bash(forge-context:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)",
      "Bash(cd:*)"
    ],
    "deny": [
      "Artifact",
      "ReportFindings",
      "ScheduleWakeup",
      "ShowOnboardingRolePicker"
    ]
  }
}
